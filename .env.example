# Google AI
GOOGLE_API_KEY=your-gemini-api-key

# GitLab
# NOTE: No server-side GitLab token. Users provide their own PAT per-request
# via the API. This token is held in memory only for the pipeline duration.
GITLAB_URL=https://gitlab.com

# API Security
API_KEY=your-api-key-for-frontend

# Model config (stable or preview)
MODEL_TIER=stable

# Cloud Run (set automatically in production)
# GOOGLE_CLOUD_PROJECT=your-project-id
# FIRESTORE_DATABASE=(default)

# Frontend origin for CORS (production)
# FRONTEND_ORIGIN=https://your-app.run.app

# Local development
PORT=8080
